{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Godot camera demo",
      "type": "cppdbg",
      "request": "launch",
      "program": "${env:HOME}/.local/bin/godot",
      "args": ["--path", "${workspaceFolder}/demo"],
      "cwd": "${workspaceFolder}",
      "environment": [
        {"name": "__NV_PRIME_RENDER_OFFLOAD", "value": "1"},
        {"name": "__GLX_VENDOR_LIBRARY_NAME", "value": "nvidia"}
      ],
      "MIMode": "gdb",
      "preLaunchTask": "Build debug"
    }
  ]
}
