{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Godot publisher (background only)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/godot-src/bin/godot.linuxbsd.template_debug.x86_64",
      "args": [
        "--path",
        "${workspaceFolder}/demo"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "__NV_PRIME_RENDER_OFFLOAD",
          "value": "1"
        },
        {
          "name": "__VK_LAYER_NV_optimus",
          "value": "NVIDIA_only"
        }
      ],
      "MIMode": "gdb"
    }
  ]
}
