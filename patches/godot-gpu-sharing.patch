+RID RenderingDevice::storage_buffer_create_from_extension(uint64_t p_buffer, uint32_t p_size) {
+	ERR_RENDER_THREAD_GUARD_V(RID());
+	ERR_FAIL_COND_V(p_buffer == 0 || p_size == 0, RID());
+	Buffer buffer;
+	buffer.size = p_size;
+	buffer.usage = RDD::BUFFER_USAGE_STORAGE_BIT;
+	buffer.driver_id = driver->buffer_create_from_extension(p_buffer, p_size);
+	ERR_FAIL_COND_V(!buffer.driver_id, RID());
+	buffer.draw_tracker = RDG::resource_tracker_create();
+	buffer.draw_tracker->buffer_driver_id = buffer.driver_id;
+	buffer_memory += buffer.size;
+	return storage_buffer_owner.make_rid(buffer);
 }
 
